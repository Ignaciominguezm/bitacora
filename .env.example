# Cabina Unria — gateway hacia el cerebro de Unria (ver src/server/gateway/)
# 'mock' (por defecto) usa MockAdapter sin más. 'openclaw-cli' invoca el CLI
# de OpenClaw en el mismo host y cae a MockAdapter si falla o no está
# instalado. El CLI gestiona su propia autenticación contra el gateway local
# de OpenClaw (127.0.0.1) — Bitácora no maneja ni ve ese token.
CABINA_GATEWAY=mock
OPENCLAW_BIN=openclaw
OPENCLAW_AGENT_ID=main
OPENCLAW_TIMEOUT_SECONDS=60
