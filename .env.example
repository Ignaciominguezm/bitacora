# #753 — runner de migraciones (dist/migrate.js / servicio "migrator" en
# docker-compose.yml). Roles dedicados con DDL+GRANT (bitacora_migrator,
# finanzas_migrator; ver migrations/bootstrap.sql), separados de las
# credenciales runtime de arriba, que nunca deben tener DDL. Solo viven en
# el .env del VPS, nunca en el compose.
BITACORA_MIGRATION_DATABASE_URL=
FINANZAS_MIGRATION_DATABASE_URL=

# Cabina Unria — gateway hacia el cerebro de Unria (ver src/server/gateway/)
# 'mock' (por defecto): MockAdapter sin más.
# 'openclaw-cli': invoca el CLI de OpenClaw en el mismo host.
# 'openclaw-gateway': llama al gateway HTTP de OpenClaw (la sobremesa, vía
#   Tailscale). Ambos modos openclaw-* caen a MockAdapter si fallan.
CABINA_GATEWAY=mock
OPENCLAW_BIN=openclaw
OPENCLAW_AGENT_ID=main
OPENCLAW_TIMEOUT_SECONDS=60
OPENCLAW_GATEWAY_URL=https://imm-guarida.tailf37d92.ts.net
OPENCLAW_GATEWAY_TOKEN=
# /v1/responses no tiene sesión propia (confirmado con curl real — session/
# sessionKey/conversation/conversation_id dan 400; metadata.session y
# previous_response_id no aíslan nada). OpenClawGatewayAdapter mete el
# resumen (si existe) + los últimos N mensajes de cabina_messages en el
# input para dar continuidad a cada conversación de Cabina. N mensajes:
OPENCLAW_HISTORY_MESSAGES=10
